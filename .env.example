DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GROQ_API_KEY=gsk_...

# Groq free models: llama-3.3-70b-versatile, mixtral-8x7b-32768
LLM_MODEL=claude-sonnet-4-6

POLL_INTERVAL_SECONDS=30
# Pipe-separated (URNs themselves contain commas)
DATASET_URNS=urn:li:dataset:(urn:li:dataPlatform:snowflake,b2fd91.order_entry_db.order_entry.customers,PROD)
